rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public READ for all uploaded site content media assets
    // WRITE restricted to authenticated admin users
    match /siteContent/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
